<idea-plugin>
    <id>moe.lolosia.keel.idea</id>
    <name>Keel</name>
    <vendor>lolosia</vendor>
    <description>识别 Keel 插件工程，并把构建与运行拆成 IDEA 的运行配置。</description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>
    <depends>com.intellij.gradle</depends>
    <depends>org.jetbrains.kotlin</depends>

    <extensions defaultExtensionNs="com.intellij">
        <configurationType implementation="moe.lolosia.keel.idea.run.KeelRunConfigurationType"/>
        <runConfigurationProducer implementation="moe.lolosia.keel.idea.run.KeelRunConfigurationProducer"/>
        <postStartupActivity implementation="moe.lolosia.keel.idea.run.KeelProjectStartupActivity"/>
        <!-- Debug executor：虫子按钮据此判断有没有可用的调试器 -->
        <programRunner implementation="moe.lolosia.keel.idea.debug.KeelDebugRunner"/>
        <xdebugger.breakpointType implementation="moe.lolosia.keel.idea.debug.KeelLineBreakpointType"/>
        <!-- @PublicApi：impl 与 api 镜像按 FQN 互相桥接，并优先接管实现搜索 -->
        <definitionsSearch order="first"
                           implementation="moe.lolosia.keel.idea.nav.KeelDefinitionsSearch"/>
        <definitionsScopedSearch order="first"
                                 implementation="moe.lolosia.keel.idea.nav.KeelDefinitionsScopedSearch"/>
        <!-- Ctrl+U：父声明若是 api 镜像，改跳 impl -->
        <codeInsight.gotoSuper language="kotlin" order="first"
                               implementationClass="moe.lolosia.keel.idea.nav.KeelGotoSuperHandler"/>
        <!-- Keel 自己的上下箭头：原生图标保持原生行为，这两个只做 impl 跳转 -->
        <codeInsight.lineMarkerProvider language="kotlin"
                                        implementationClass="moe.lolosia.keel.idea.nav.KeelNavigationLineMarkerProvider"/>
    </extensions>

    <!-- 只用到 Kotlin PSI（KtClassOrObject / KtNamedFunction）与继承搜索，K1/K2 行为一致 -->
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true"/>
    </extensions>
</idea-plugin>
